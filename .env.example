# Copy to .env and fill in real values. Never commit .env.

# Groq API key — get one at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Signs login tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# SQLite by default. Swap for postgresql+psycopg://user:pass@host/db to scale up.
DATABASE_URL=sqlite:///recruitment.db

# Browser origins allowed to call this API (comma-separated).
CORS_ORIGINS=http://localhost:3000

# Set to 1 to re-enable the old random score jitter.
DEMO_JITTER=0
